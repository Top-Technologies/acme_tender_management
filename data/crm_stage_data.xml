<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Dedicated Tender Sales Team -->
        <record id="crm_team_tenders" model="crm.team">
            <field name="name">Tenders Division</field>
            <field name="sequence">5</field>
            <field name="use_opportunities">True</field>
        </record>

        <!-- 8 Standard Tender Stages (Spec Section 4.1) -->
        <record id="stage_tender_identified" model="crm.stage">
            <field name="name">Identified</field>
            <field name="sequence">1</field>
            <field name="x_is_tender_stage">True</field>
            <field name="x_tender_stage_code">identified</field>
            <field name="team_ids" eval="[(4, ref('crm_team_tenders'))]"/>
            <field name="requirements">Capture client, tender number, issuer, dates, channel, bid security required, source.</field>
        </record>

        <record id="stage_tender_registered" model="crm.stage">
            <field name="name">Registered</field>
            <field name="sequence">2</field>
            <field name="x_is_tender_stage">True</field>
            <field name="x_tender_stage_code">registered</field>
            <field name="team_ids" eval="[(4, ref('crm_team_tenders'))]"/>
            <field name="requirements">Purchase decision approved; payment request processed; tender document purchased and stored in tender folder.</field>
        </record>

        <record id="stage_tender_bid_nobid" model="crm.stage">
            <field name="name">Bid/No-Bid</field>
            <field name="sequence">3</field>
            <field name="x_is_tender_stage">True</field>
            <field name="x_tender_stage_code">bid_nobid</field>
            <field name="team_ids" eval="[(4, ref('crm_team_tenders'))]"/>
            <field name="requirements">Requirement assessment completed; stock and sourcing check; Go / conditional Go / No-Go decision authorized.</field>
        </record>

        <record id="stage_tender_preparation" model="crm.stage">
            <field name="name">Preparation</field>
            <field name="sequence">4</field>
            <field name="x_is_tender_stage">True</field>
            <field name="x_tender_stage_code">preparation</field>
            <field name="team_ids" eval="[(4, ref('crm_team_tenders'))]"/>
            <field name="requirements">Tender folder created; 24-document submission checklist active; cost build-up and BOQ quotation approved.</field>
        </record>

        <record id="stage_tender_bid_security_issued" model="crm.stage">
            <field name="name">Bid security issued</field>
            <field name="sequence">5</field>
            <field name="x_is_tender_stage">True</field>
            <field name="x_tender_stage_code">bid_security_issued</field>
            <field name="team_ids" eval="[(4, ref('crm_team_tenders'))]"/>
            <field name="requirements">Bid security requested, authorized (CPO/Bank Guarantee), and instrument received by Office Manager.</field>
        </record>

        <record id="stage_tender_submitted" model="crm.stage">
            <field name="name">Submitted</field>
            <field name="sequence">6</field>
            <field name="x_is_tender_stage">True</field>
            <field name="x_tender_stage_code">submitted</field>
            <field name="team_ids" eval="[(4, ref('crm_team_tenders'))]"/>
            <field name="requirements">Package reviewed, signed, sealed, submitted physically or online, and proof attached.</field>
        </record>

        <record id="stage_tender_under_evaluation" model="crm.stage">
            <field name="name">Under evaluation</field>
            <field name="sequence">7</field>
            <field name="x_is_tender_stage">True</field>
            <field name="x_tender_stage_code">under_evaluation</field>
            <field name="team_ids" eval="[(4, ref('crm_team_tenders'))]"/>
            <field name="requirements">Technical and financial opening records; correspondence letters.</field>
        </record>

        <record id="stage_tender_won_lost" model="crm.stage">
            <field name="name">Won / Lost</field>
            <field name="sequence">8</field>
            <field name="is_won">True</field>
            <field name="x_is_tender_stage">True</field>
            <field name="x_tender_stage_code">won_lost</field>
            <field name="team_ids" eval="[(4, ref('crm_team_tenders'))]"/>
            <field name="requirements">Final outcome record completed; handover to Operations (Won) or win/loss analysis (Lost/Cancelled).</field>
        </record>
    </data>
</odoo>

