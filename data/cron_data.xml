<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily Tender Deadline Reminders (Spec 7.1) -->
        <record id="ir_cron_tender_deadline_reminders" model="ir.cron">
            <field name="name">Tenders: Deadline Reminders (LC-1)</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_tender_deadlines()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Weekly Tender Library Expiry Check (Spec 7.3) -->
        <record id="ir_cron_tender_library_expiry" model="ir.cron">
            <field name="name">Tenders: Library Document Expiry Review</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_library_validity()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>

