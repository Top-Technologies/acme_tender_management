<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_tender_roles" model="ir.ui.view">
        <field name="name">res.company.form.tender.roles</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Tender Approval Roles">
                    <field name="tender_edm_user_id"/>
                    <field name="tender_dm_user_id"/>
                    <field name="tender_dgm_user_id"/>
                    <field name="tender_gm_user_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
