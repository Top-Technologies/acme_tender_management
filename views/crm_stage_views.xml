<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_stage_form_inherit_tender" model="ir.ui.view">
        <field name="name">crm.stage.form.inherit.tender</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_won']" position="after">
                <field name="x_is_tender_stage"/>
                <field name="x_tender_stage_code" invisible="not x_is_tender_stage"/>
            </xpath>
        </field>
    </record>

    <record id="crm_stage_tree_inherit_tender" model="ir.ui.view">
        <field name="name">crm.stage.list.inherit.tender</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_won']" position="after">
                <field name="x_is_tender_stage"/>
                <field name="x_tender_stage_code"/>
            </xpath>
        </field>
    </record>
</odoo>

