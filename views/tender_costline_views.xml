<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tender_costline_tree" model="ir.ui.view">
        <field name="name">tender.costline.list</field>
        <field name="model">tender.costline</field>
        <field name="arch" type="xml">
            <list string="BOQ Cost Build-up Lines">
                <field name="tender_id"/>
                <field name="sale_order_line_id" string="BOQ Item"/>
                <field name="product_id" string="Cost Component"/>
                <field name="component_type"/>
                <field name="description"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="rate" widget="monetary"/>
                <field name="total_cost" widget="monetary" sum="Total Direct Cost"/>
                <field name="source_of_rate"/>
                <field name="supplier_offer_id"/>
                <field name="earlier_rate_display"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_tender_costline_form" model="ir.ui.view">
        <field name="name">tender.costline.form</field>
        <field name="model">tender.costline</field>
        <field name="arch" type="xml">
            <form string="BOQ Cost Component">
                <sheet>
                    <group>
                        <group string="BOQ Item &amp; Component">
                            <field name="sale_order_line_id" string="BOQ Item"/>
                            <field name="product_id" string="Cost Component"/>
                            <field name="component_type"/>
                            <field name="description"/>
                            <field name="revision"/>
                        </group>
                        <group string="Cost Rate &amp; Source (Costs Only)">
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="rate" widget="monetary"/>
                            <field name="total_cost" widget="monetary"/>
                            <field name="source_of_rate"/>
                            <field name="supplier_offer_id" invisible="source_of_rate != 'rfq'"/>
                            <field name="earlier_tender_costline_id" invisible="source_of_rate != 'earlier_tender'"/>
                            <field name="earlier_rate_display" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

