<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated Tender Kanban View (Spec Section 6.2) -->
    <record id="view_crm_lead_tender_kanban" model="ir.ui.view">
        <field name="name">crm.lead.tender.kanban</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false" records_draggable="true">
                <field name="stage_id"/>
                <field name="x_tender_code"/>
                <field name="x_tender_number"/>
                <field name="partner_id"/>
                <field name="name"/>
                <field name="x_submission_deadline"/>
                <field name="x_bid_security_required"/>
                <field name="x_bid_security_amount"/>
                <field name="x_bid_security_return_status"/>
                <field name="x_checklist_progress"/>
                <field name="x_boq_complete"/>
                <field name="x_library_validity_warning"/>
                <field name="currency_id"/>
                <field name="user_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge rounded-pill bg-primary text-white fw-bold">
                                    <field name="x_tender_code"/>
                                </span>
                                <t t-if="record.x_boq_complete.raw_value">
                                    <span class="badge bg-success-light text-success" title="BOQ Cost Complete">BOQ Complete</span>
                                </t>
                                <t t-else="">
                                    <span class="badge bg-warning-light text-warning" title="BOQ Cost Incomplete">BOQ Pending</span>
                                </t>
                            </div>
                            <div class="fw-bold fs-6 text-truncate mb-1">
                                <field name="name"/>
                            </div>
                            <div class="text-muted small mb-1">
                                <i class="fa fa-building me-1" title="Client"/> <field name="partner_id"/>
                            </div>
                            <t t-if="record.x_tender_number.raw_value">
                                <div class="text-muted small mb-1">
                                    <i class="fa fa-tag me-1" title="Tender Number"/> Tender #: <field name="x_tender_number"/>
                                </div>
                            </t>
                            <t t-if="record.x_submission_deadline.raw_value">
                                <div class="small fw-semibold text-danger mb-1">
                                    <i class="fa fa-clock-o me-1" title="Deadline"/> Deadline: <field name="x_submission_deadline"/>
                                </div>
                            </t>
                            <t t-if="record.x_bid_security_required.raw_value">
                                <div class="small text-secondary mb-1">
                                    <i class="fa fa-shield me-1" title="Security"/> Security: <field name="x_bid_security_amount" widget="monetary"/>
                                    <span class="badge bg-info ms-1"><field name="x_bid_security_return_status"/></span>
                                </div>
                            </t>
                            <t t-if="record.x_library_validity_warning.raw_value">
                                <div class="small text-danger fw-bold mb-1">
                                    <i class="fa fa-exclamation-triangle me-1" title="Expiry Warning"/> Library Expiry Warning
                                </div>
                            </t>
                            <div class="d-flex align-items-center justify-content-between mt-2 pt-1 border-top">
                                <div class="small text-muted" title="Checklist Completion">
                                    <i class="fa fa-check-square-o me-1" title="Progress"/>
                                    <field name="x_checklist_progress" widget="progressbar"/>
                                </div>
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dedicated Tender List / Tree View (Spec Section 6.4) -->
    <record id="view_crm_lead_tender_tree" model="ir.ui.view">
        <field name="name">crm.lead.tender.list</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <list string="Tenders" decoration-danger="x_library_validity_warning" decoration-success="x_outcome_type == 'won'" decoration-muted="x_outcome_type in ('lost', 'no_go', 'cancelled')">
                <field name="x_tender_code"/>
                <field name="name" string="Tender Title"/>
                <field name="partner_id" string="Client"/>
                <field name="x_tender_number"/>
                <field name="x_issuer_id"/>
                <field name="x_submission_deadline" widget="remaining_days"/>
                <field name="x_bid_security_amount" widget="monetary"/>
                <field name="x_bid_security_return_status"/>
                <field name="x_checklist_progress" widget="progressbar"/>
                <field name="x_boq_complete"/>
                <field name="stage_id"/>
                <field name="x_outcome_type"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="x_library_validity_warning" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Dedicated Tender Form View (Spec Section 6.3) -->
    <record id="view_crm_lead_tender_form" model="ir.ui.view">
        <field name="name">crm.lead.tender.form</field>
        <field name="model">crm.lead</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Tender">
                <header>
                    <button name="action_generate_standard_checklist" string="Generate 24 Standard Documents" type="object" class="btn-primary" invisible="stage_id != %(acme_tender_management.stage_tender_preparation)d and stage_id != %(acme_tender_management.stage_tender_bid_nobid)d"/>
                    <button name="%(acme_tender_management.action_tender_copy_wizard)d" string="Start from Earlier Tender" type="action" class="btn-secondary"/>
                    <button name="action_request_bid_security" string="Request Bid Security" type="object" class="btn-secondary" invisible="not x_can_request_bid_security"/>
                    <button name="action_issue_bid_security" string="Record Instrument Received" type="object" class="btn-info" invisible="not x_can_issue_bid_security"/>
                    <button name="action_confirm_bid_security_return" string="Confirm Bid Security Return (Finance)" type="object" class="btn-success" invisible="x_bid_security_return_status != 'open'" groups="acme_tender_management.group_tender_finance,acme_tender_management.group_tender_manager"/>
                    <button name="action_tender_won" string="Award &amp; Handover to Operations" type="object" class="btn-success fw-bold" invisible="not x_can_finalize_tender_outcome or stage_id != %(acme_tender_management.stage_tender_under_evaluation)d or x_outcome_type == 'won'"/>
                    <button name="action_tender_lost" string="Finalize as Lost" type="object" class="btn-danger" invisible="not x_can_finalize_tender_outcome or stage_id != %(acme_tender_management.stage_tender_under_evaluation)d or x_outcome_type == 'lost'"/>
                    <field name="stage_id" widget="statusbar" domain="[('x_is_tender_stage', '=', True)]" options="{'clickable': '0'}"/>
                    <field name="x_can_request_bid_security" invisible="1"/>
                    <field name="x_can_issue_bid_security" invisible="1"/>
                    <field name="x_can_finalize_tender_outcome" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_quotations" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="x_quotation_count" widget="statinfo" string="Quotations (BOQ)"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-tasks">
                            <field name="x_checklist_progress" widget="percentpie" string="Checklist"/>
                        </button>
                    </div>

                    <!-- Alert Banners -->
                    <div class="alert alert-warning mb-2" role="alert" invisible="not x_library_validity_warning">
                        <i class="fa fa-exclamation-triangle me-2" title="Warning"/>
                        <field name="x_library_warning_message" readonly="1"/>
                    </div>

                    <div class="oe_title">
                        <label for="x_tender_code" string="Tender Lifecycle Code"/>
                        <h1>
                            <field name="x_tender_code" readonly="1" class="text-primary"/>
                        </h1>
                        <label for="name" string="Tender Title / Project Scope"/>
                        <h2>
                            <field name="name" placeholder="e.g. Supply and Installation of Modular Datacenter"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Client &amp; Authority Details">
                            <field name="partner_id" string="Client / Customer" required="1"/>
                            <field name="x_tender_number" placeholder="e.g. WB/ME/NCB/01/2026"/>
                            <field name="x_issuer_id" placeholder="Procuring Entity if different from client"/>
                            <field name="x_source"/>
                            <field name="x_submission_channel"/>
                            <field name="user_id" string="Assigned Sales Engineer" widget="many2one_avatar_user"/>
                        </group>
                        <group string="Tender Status &amp; Decision">
                            <field name="x_go_no_go_decision" readonly="1"/>
                            <field name="x_outcome_type"/>
                            <field name="x_winner_name" invisible="x_outcome_type != 'lost'"/>
                            <field name="x_winning_price" invisible="x_outcome_type != 'lost'"/>
                            <field name="x_lost_reason_id" invisible="not x_outcome_type or x_outcome_type == 'won'"/>
                            <field name="x_boq_complete" readonly="1"/>
                            <field name="x_documents_folder_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab 1: Key Deadlines & Submission -->
                        <page string="Key Deadlines" name="deadlines">
                            <group>
                                <group string="Preparation &amp; Site Visit">
                                    <field name="x_doc_purchase_deadline"/>
                                    <field name="x_site_visit_required"/>
                                    <field name="x_site_visit_date" invisible="not x_site_visit_required"/>
                                </group>
                                <group string="Submission &amp; Openings">
                                    <field name="x_submission_deadline" required="1"/>
                                    <field name="x_tech_opening_date"/>
                                    <field name="x_fin_opening_date"/>
                                    <field name="x_submission_proof_attachment_id" filename="name"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 2: Bid Security (CPO / Guarantee) -->
                        <page string="Bid Security" name="bid_security">
                            <group>
                                <group string="Security Instrument Requirements">
                                    <field name="x_bid_security_required"/>
                                    <field name="x_bid_security_type" invisible="not x_bid_security_required"/>
                                    <field name="x_bid_security_amount" invisible="not x_bid_security_required"/>
                                    <field name="x_bank_name" invisible="not x_bid_security_required"/>
                                </group>
                                <group string="Issuance &amp; Recovery Status (Section 8)">
                                    <field name="x_bid_security_issue_date" invisible="not x_bid_security_required"/>
                                    <field name="x_expected_return_date" invisible="not x_bid_security_required"/>
                                    <field name="x_bid_security_return_status" invisible="not x_bid_security_required"/>
                                    <field name="x_bid_security_return_date" invisible="x_bid_security_return_status != 'returned'"/>
                                    <field name="x_bid_security_approval_id" readonly="1" invisible="not x_bid_security_approval_id"/>
                                </group>
                            </group>
                            <group string="Recovery Follow-up Notes">
                                <field name="x_bid_security_return_notes" placeholder="Instrument tracking history, messenger receipt, delegation letter..."/>
                            </group>
                        </page>

                        <!-- Tab 3: Requirement Assessment (Spec 5.2) -->
                        <page string="Requirement Assessment" name="assessment">
                            <p class="text-muted small">
                                Structured requirement assessment lines created at Bid/No-Bid. Mandatory failures drive the Go/No-Go decision.
                            </p>
                            <field name="x_assessment_ids">
                                <list editable="bottom" decoration-danger="failure_type == 'mandatory_failure'" decoration-warning="failure_type == 'manageable_risk'">
                                    <field name="category"/>
                                    <field name="requirement"/>
                                    <field name="source_page_clause"/>
                                    <field name="is_mandatory"/>
                                    <field name="assessment"/>
                                    <field name="failure_type"/>
                                    <field name="gap"/>
                                    <field name="owner_id"/>
                                    <field name="action"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 4: Go/No-Go Decision Records -->
                        <page string="Go/No-Go Decision" name="decision">
                            <field name="x_decision_ids">
                                <list>
                                    <field name="decision"/>
                                    <field name="state"/>
                                    <field name="recommended_by_id"/>
                                    <field name="reviewed_by_id"/>
                                    <field name="authorized_by_id"/>
                                    <field name="approval_date"/>
                                </list>
                            </field>
                        </page>

                        <!-- Submission Checklist -->
                        <page string="Submission Checklist (24 Docs)" name="checklist">
                            <div class="mb-2">
                                <button name="action_generate_standard_checklist" string="Pre-load 24 Standard Documents" type="object" class="btn btn-outline-primary btn-sm"/>
                            </div>
                            <field name="x_checklist_ids">
                                <list editable="bottom" decoration-danger="not is_valid_for_tender" decoration-success="review_status == 'approved'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="document_code"/>
                                    <field name="name"/>
                                    <field name="is_mandatory"/>
                                    <field name="source_type"/>
                                    <field name="library_document_id"/>
                                    <field name="document_version"/>
                                    <field name="validity_date"/>
                                    <field name="validity_warning" widget="badge" decoration-danger="1" invisible="is_valid_for_tender"/>
                                    <field name="preparer_id"/>
                                    <field name="preparation_status"/>
                                    <field name="reviewer_id"/>
                                    <field name="review_status"/>
                                    <field name="attachment_id"/>
                                    <field name="due_date"/>
                                    <field name="is_valid_for_tender" column_invisible="True"/>
                                </list>
                            </field>
                        </page>

                        <!-- BoQ Lines -->
                        <page string="BoQ Lines" name="boq_lines">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold">Tender BoQ Lines</span>
                                <div>
                                    <button name="action_import_tender_boq" string="Import BOQ Excel" type="object" class="btn btn-outline-primary btn-sm ms-1" groups="acme_tender_management.group_tender_user,acme_tender_management.group_tender_reviewer,acme_tender_management.group_tender_approver,acme_tender_management.group_tender_finance,acme_tender_management.group_tender_manager"/>
                                    <button name="action_export_tender_boq" string="Export BOQ Excel" type="object" class="btn btn-outline-success btn-sm ms-1" groups="acme_tender_management.group_tender_user,acme_tender_management.group_tender_reviewer,acme_tender_management.group_tender_approver,acme_tender_management.group_tender_finance,acme_tender_management.group_tender_manager"/>
                                    <button name="action_create_tender_quotation" string="+ New Tender Quotation" type="object" class="btn btn-outline-secondary btn-sm ms-1"/>
                                </div>
                            </div>
                            <field name="x_current_boq_order_id" invisible="1"/>
                            <field name="x_boq_lines_readonly" invisible="1"/>
                            <field name="x_boq_line_ids"
                                   domain="[('order_id', '=', x_current_boq_order_id), ('display_type', '=', False)]"
                                   context="{'default_order_id': x_current_boq_order_id}"
                                   readonly="x_boq_lines_readonly">
                                <list editable="bottom">
                                    <field name="x_bill_no" width="80px"/>
                                    <field name="x_item_ref" width="100px"/>
                                    <field name="x_bill_category_id" width="150px"/>
                                    <field name="product_id" width="150px"/>
                                    <field name="name" string="Description" width="600px"/>
                                    <field name="product_uom_id" string="Unit" width="80px"/>
                                    <field name="product_uom_qty" string="Quantity" width="100px"/>
                                    <field name="x_boq_unit_rate" string="Unit Rate" widget="monetary" width="120px"/>
                                    <field name="x_boq_amount" string="Amount" widget="monetary" width="120px" sum="Total"/>
                                    <field name="x_rolled_up_cost" string="Built-up Cost" widget="monetary" width="120px"/>
                                    <field name="x_cost_built" string="Cost Built" width="90px"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <button name="action_add_tender_boq_line" string="Add a line" type="object" class="oe_link" invisible="x_current_boq_order_id or (stage_id != %(acme_tender_management.stage_tender_preparation)d and stage_id != %(acme_tender_management.stage_tender_bid_security_issued)d)"/>
                            <group string="Imported BoQ Files">
                                <field name="x_boq_import_file_ids" nolabel="1" readonly="1">
                                    <list create="0" delete="0" edit="0">
                                        <field name="filename"/>
                                        <field name="created_boq_line_count" string="Created BOQ Lines"/>
                                        <field name="imported_on"/>
                                        <field name="imported_by_id"/>
                                        <button name="action_remove_imported_boq" string="Remove Import &amp; Lines" type="object" icon="fa-trash" class="btn-link text-danger"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <!-- BOQ Cost Build-up -->
                        <page string="BOQ Cost Build-up" name="boq_cost_build_up">
                            <field name="x_costline_ids" context="{'default_tender_id': id}">
                                <list editable="bottom" string="BOQ Cost Build-up Lines">
                                    <field name="sale_order_line_id" string="BOQ Item" domain="[('x_tender_id', '=', parent.id), ('display_type', '=', False)]" required="1"/>
                                    <field name="product_id" string="Cost Component"/>
                                    <field name="component_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="rate" widget="monetary"/>
                                    <field name="total_cost" widget="monetary" sum="Total Direct Cost" readonly="1"/>
                                    <field name="source_of_rate"/>
                                    <field name="supplier_offer_id" optional="hide"/>
                                    <field name="earlier_rate_display" optional="hide"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>


                        <!-- Tab 6: Summary Sheet -->
                        <page string="Summary Bills" name="summary_sheet">
                            <h3 class="mb-3">Summary Bills</h3>
                            <field name="x_bill_summary_ids" class="o_tender_summary_full_height" nolabel="1" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="bill_no"/>
                                    <field name="bill_category"/>
                                    <field name="boq_amount" widget="monetary" sum="BOQ Total"/>
                                    <field name="cost_build_up_amount" widget="monetary" sum="Cost Total"/>
                                    <field name="amount" string="Total Amount" widget="monetary" sum="Grand Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group>
                                <field name="x_boq_vat_rate"/>
                            </group>
                            <group class="oe_subtotal_footer">
                                <field name="x_boq_amount_untaxed" widget="monetary" readonly="1"/>
                                <field name="x_boq_amount_vat" widget="monetary" readonly="1"/>
                                <field name="x_boq_amount_total" widget="monetary" readonly="1" class="fw-bold"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>

                        <!-- Tab 7: Bid Openings & Final Outcome -->
                        <page string="Bid Openings &amp; Outcome" name="openings">
                            <group>
                                <group string="Technical Bid Opening [ACME/OF/74]">
                                    <field name="x_opening_tech_id"/>
                                </group>
                                <group string="Financial Bid Opening [ACME/OF/75]">
                                    <field name="x_opening_fin_id"/>
                                </group>
                            </group>
                            <group string="Final Outcome Record">
                                <field name="x_outcome_id"/>
                                <field name="x_award_letter_attachment_id" filename="name"/>
                            </group>
                        </page>

                        <!-- Tab 8: Joint Venture & Legal -->
                        <page string="Joint Venture &amp; Legal" name="jv_legal">
                            <group>
                                <field name="x_joint_venture_id" domain="[('category_id.name', 'ilike', 'Joint-venture')]"/>
                                <field name="x_jv_agreement_attachment_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <!-- Tender Search View (Spec Section 6.4) -->
    <record id="view_crm_lead_tender_search" model="ir.ui.view">
        <field name="name">crm.lead.tender.search</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <search string="Search Tenders">
                <field name="name" string="Tender Title / Code" filter_domain="['|', '|', ('name', 'ilike', self), ('x_tender_code', 'ilike', self), ('x_tender_number', 'ilike', self)]"/>
                <field name="partner_id" string="Client"/>
                <field name="x_issuer_id" string="Procuring Authority"/>
                <field name="x_tender_number" string="Tender Number"/>
                <field name="user_id" string="Sales Engineer"/>
                <separator/>
                <filter string="Active Tenders" name="filter_active" domain="[('stage_id.x_tender_stage_code', 'not in', ('won_lost',))]"/>
                <filter string="Open Bid Security Recovery" name="filter_open_bid_security" domain="[('x_bid_security_return_status', '=', 'open')]"/>
                <filter string="Library Validity Warnings" name="filter_validity_warnings" domain="[('x_library_validity_warning', '=', True)]"/>
                <filter string="Won Tenders" name="filter_won" domain="[('x_outcome_type', '=', 'won')]"/>
                <filter string="Lost Tenders" name="filter_lost" domain="[('x_outcome_type', '=', 'lost')]"/>
                <separator/>
                <filter string="Group By: Stage" name="group_stage" context="{'group_by': 'stage_id'}"/>
                <filter string="Group By: Client" name="group_client" context="{'group_by': 'partner_id'}"/>
                <filter string="Group By: Sales Engineer" name="group_user" context="{'group_by': 'user_id'}"/>
                <filter string="Group By: Outcome Type" name="group_outcome" context="{'group_by': 'x_outcome_type'}"/>
                <filter string="Group By: Bid Security Status" name="group_security_status" context="{'group_by': 'x_bid_security_return_status'}"/>
                <filter string="Group By: Submission Deadline" name="group_deadline" context="{'group_by': 'x_submission_deadline:month'}"/>
            </search>
        </field>
    </record>
</odoo>
