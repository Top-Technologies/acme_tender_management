<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tender_boq_import_wizard_form" model="ir.ui.view">
        <field name="name">tender.boq.import.wizard.form</field>
        <field name="model">tender.boq.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import BoQ Lines">
                <group>
                    <field name="tender_id"/>
                    <field name="file" filename="filename" invisible="import_done"/>
                    <field name="filename" invisible="1"/>
                    <field name="result_message" invisible="not import_done" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Import BoQ Lines" type="object" class="btn-primary" invisible="import_done"/>
                    <button string="Close" special="cancel" class="btn-secondary" invisible="not import_done"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
